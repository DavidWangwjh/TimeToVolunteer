APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# From Supabase Dashboard → Project Settings → API
# Project URL must look like: https://abcdefghijklmnopqrst.supabase.co (20-char project ref)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) or legacy anon key (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (sb_secret_...) or legacy service_role key (eyJ...) — server only
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
